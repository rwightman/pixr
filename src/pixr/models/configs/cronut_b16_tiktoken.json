    "cronut": {
        "width": 768,
        "depth": 12,
        "num_heads": 12,
        "intermediate_size": 2048,
        "text_embed_dim": 768,
        "patch_size": 16,
        "mrope_section": [
            11,
            11,
            10
        ],
        "attn_backend": "flex"
    }
}
