{
    "type": "cronut",
    "image_encoder": {
        "name": "cronut",
        "pretrained": false,
        "image_fmt": "L",
        "max_seq_len": 4096,
        "image_mean": [
            0.5
        ],
        "image_std": [
            0.5
        ]
    },
    "text_decoder": {
        "name": "tiktoken:cl100k_base",
