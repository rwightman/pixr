{
    "type": "cruller",
    "image_encoder": {
        "name": "naflexvit",
        "pretrained_from": "vit_large_patch14_clip_quickgelu_224.openai",
        "model_kwargs": {
            "patch_size": 14,
            "embed_dim": 1024,
            "depth": 24,
            "num_heads": 16,
            "class_token": true,
            "pre_norm": true,
            "act_layer": "quick_gelu",
            "norm_layer": "layernorm",
            "pos_embed_grid_size": [
                16,
                16
            ],
            "pos_embed_interp_mode": "bicubic"
        },
        "image_fmt": "L",
        "max_seq_len": 6144
    },
    "text_decoder": {
        "name": "facebook/bart-large",
        "pretrained": true,
        "num_layers": 8,
        "max_length": 1024
    }
}
